<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="{{robots}}"><meta name="proto-site-id" content="{{siteId}}">
  <meta name="description" content="{{metaDescription}}"><title>{{title}}</title>
  <meta property="og:title" content="{{title}}"><meta property="og:description" content="{{metaDescription}}"><meta property="og:type" content="website">
  <link rel="stylesheet" href="./style.css"><link rel="preload" href="./assets/dm-serif.ttf" as="font" type="font/ttf" crossorigin>
  <script src="./site.js" defer></script>
</head>
<body class="signature palette-{{palette}} layout-{{layout}}" data-google-enabled="{{liveGoogle}}" data-reference="{{liveTitle}}" data-profile-site="{{reference}}" data-hero-index="{{googleHeroIndex}}">
  <a class="skip-link" href="#main">Skip to content</a>
  {{#if demo}}<div class="sample-note">Fictional business &middot; Design demonstration</div>{{/if}}
  <header class="site-header">
    <a class="wordmark" href="#home" aria-label="{{displayName}} home" {{#if liveBrand}}data-brand-home{{/if}}>{{#if logoId}}<img class="brand-logo" src="./logo.webp" alt="{{displayName}} logo" width="180" height="60">{{else}}<span class="wordmark-name"><span {{#if liveBrand}}data-profile-brand{{/if}}>{{#if liveBrand}}Welcome{{else}}{{displayName}}{{/if}}</span><span class="wordmark-dot">.</span></span>{{/if}}</a>
    <nav id="main-nav" class="main-nav" aria-label="Main navigation">
      {{#if services}}<a href="#services">Services</a>{{/if}}{{#if gallery}}<a href="#portfolio">Gallery</a>{{/if}}{{#if about}}<a href="#about">About</a>{{/if}}{{#if copy.faqs}}<a href="#questions">FAQs</a>{{/if}}
      {{#if reference}}{{#unless about}}<a href="#about" data-about-nav hidden>About</a>{{/unless}}{{/if}}
      {{#if liveGoogle}}<a href="#gallery" data-gallery-nav hidden>{{#if gallery}}More photos{{else}}Gallery{{/if}}</a><a href="#reviews" data-review-nav hidden>Reviews</a>{{/if}}
      {{#if reference}}{{#unless copy.faqs}}<a href="#questions" data-faq-nav hidden>FAQs</a>{{/unless}}{{/if}}
    </nav>
    <a class="button button-small header-enquire" href="#contact">Get in touch <img src="./assets/arrow-up-right.svg" alt="" width="18" height="18"></a>
    <button class="icon-button menu-toggle" type="button" title="Open menu" aria-label="Open menu" aria-expanded="false" aria-controls="main-nav"><img src="./assets/menu.svg" alt="" width="23" height="23"></button>
  </header>
  <main id="main">
    <section class="hero-zone" id="home" aria-labelledby="hero-title">
      <div class="hero {{#if localHero}}has-image{{/if}}">
        {{#if localHero}}<img class="hero-image hero-photo" src="./hero.webp" alt="{{#if illustrativeHero}}Illustrative event photograph{{else}}{{displayName}} photograph{{/if}}" fetchpriority="high">{{else}}{{#if liveGoogle}}<img class="hero-image hero-photo" data-hero-photo alt="" hidden fetchpriority="high">{{/if}}{{/if}}
        <div class="hero-content container">
          <p class="eyebrow hero-eyebrow"><span></span><span {{#if reference}}data-live="category"{{/if}}>{{#unless reference}}{{category}}{{/unless}}</span><span {{#if reference}}data-live="city"{{/if}}>{{city}}</span></p>
          <h1 id="hero-title" {{#if liveBrand}}data-profile-heading{{/if}}>{{#if liveBrand}}<em>Welcome.</em>{{else}}{{#if namePrefix}}{{namePrefix}}<br>{{/if}}<em>{{nameLast}}</em>{{/if}}</h1>
          {{#if reference}}<span class="google-mark hero-source" translate="no">Google Maps</span>{{/if}}
          {{#if copy.headline}}<p class="hero-tagline">{{copy.headline}}</p>{{else}}{{#if reference}}<p class="hero-tagline" data-profile-tagline hidden></p>{{/if}}{{/if}}{{#if intro}}<p class="hero-description">{{intro}}</p>{{else}}{{#if reference}}<p class="hero-description" data-profile-intro hidden></p>{{/if}}{{/if}}
          <div class="hero-actions"><a class="button button-light" href="#contact"><span {{#if reference}}data-contact-label{{/if}}>Let's connect</span> <img src="./assets/arrow-up-right.svg" alt="" width="19" height="19"></a>{{#if gallery}}<a class="hero-gallery-link" href="#portfolio">Explore the gallery <img src="./assets/arrow-right.svg" alt="" width="18" height="18"></a>{{else}}{{#if liveGoogle}}<a class="hero-gallery-link" href="#gallery" data-gallery-nav hidden>Explore the gallery <img src="./assets/arrow-right.svg" alt="" width="18" height="18"></a>{{/if}}{{/if}}</div>
        </div>
      </div>
      <div class="hero-media-credit" data-hero-credit>{{#if illustrativeHero}}Illustrative photography &middot; <a href="https://images.unsplash.com/photo-1511795409834-ef04bbd61622" target="_blank" rel="noopener noreferrer">Unsplash</a>{{/if}}</div>
    </section>
    {{#if services}}<div class="occasion-band service-band"><div class="container"><p>LET'S TALK ABOUT<br><strong>your next occasion.</strong></p>{{#each services}}<a href="#contact" data-service="{{title}}">{{title}}<img src="./assets/arrow-up-right.svg" alt="" width="18" height="18"></a>{{/each}}</div></div>{{/if}}
    {{#if liveGoogle}}<div class="profile-strip" data-profile-strip hidden><div class="container"><strong><span data-live="rating"></span> / 5</strong><span data-live="reviewCount"></span><a data-maps-link href="{{mapsHref}}" target="_blank" rel="noopener noreferrer">View profile</a><span class="google-mark" translate="no">Google Maps</span></div></div><div class="google-status container" data-google-status role="status">Loading business details...</div>{{/if}}
    {{#if reference}}{{#unless services}}<div class="occasion-band visit-band" data-visit-band hidden><div class="container"><p>COME SAY HELLO<br><strong data-visit-band-title></strong></p><a href="#gallery" data-gallery-nav hidden>Take a look <img src="./assets/arrow-up-right.svg" alt="" width="18" height="18"></a><a href="#contact" data-contact-label>Plan your visit</a><a href="#questions" data-faq-nav hidden>A few useful details <img src="./assets/arrow-up-right.svg" alt="" width="18" height="18"></a></div></div>{{/unless}}{{/if}}

    {{#if services}}<section class="section services container" id="services" aria-labelledby="services-title"><div class="section-top"><div><p class="eyebrow">WHAT WE BRING TO THE TABLE</p><h2 id="services-title">The idea. The details.<br><em>The coming together.</em></h2></div></div><div class="services-list">{{#each services}}<article class="service"><span class="service-number">{{number}}</span><h3>{{title}}</h3>{{#if description}}<p>{{description}}</p>{{/if}}<a class="text-link" href="#contact" data-service="{{title}}">Let's talk <img src="./assets/arrow-up-right.svg" alt="" width="19" height="19"></a></article>{{/each}}</div></section>{{/if}}

    {{#if gallery}}<section class="gallery-section section" id="portfolio" aria-labelledby="portfolio-title"><div class="container"><div class="section-top"><div><p class="eyebrow">A SENSE OF THE OCCASION</p><h2 id="portfolio-title">Find your kind<br><em>of celebration.</em></h2></div><div class="gallery-controls">{{#if showFilters}}<div class="filter-tabs" role="group" aria-label="Gallery category"><button type="button" data-filter="all" aria-pressed="true">All</button>{{#each filters}}<button type="button" data-filter="{{id}}" aria-pressed="false">{{label}}</button>{{/each}}</div>{{/if}}{{#if sampleGallery}}<span class="gallery-disclosure">Illustrative photography, not completed projects.</span>{{/if}}</div></div><div class="portfolio-grid">{{#each gallery}}<figure data-category="{{category}}"><button type="button" class="photo-button" data-owned-photo aria-label="View {{caption}}"><img src="{{url}}" alt="{{#if illustrative}}Illustrative photograph: {{/if}}{{caption}}" width="1100" height="734" loading="lazy"><span class="photo-open"><img src="./assets/plus.svg" alt="" width="20" height="20"></span></button><figcaption><h3>{{caption}}</h3>{{#if illustrative}}<span>Illustrative &middot; Unsplash</span>{{/if}}</figcaption></figure>{{/each}}</div><p class="sr-only" data-gallery-status aria-live="polite"></p></div></section>{{/if}}

    {{#if about}}<section class="section about container {{#unless aboutPhoto}}text-only{{/unless}}" id="about" aria-labelledby="about-title">{{#if aboutPhoto}}<div class="about-photo"><img src="{{aboutPhoto}}" alt="{{aboutPhotoAlt}}" width="1100" height="733" loading="lazy">{{#if sampleGallery}}<span>ILLUSTRATIVE PHOTOGRAPHY</span>{{/if}}</div>{{/if}}<div class="about-copy"><p class="eyebrow">A LITTLE ABOUT US</p><h2 id="about-title">{{#if copy.aboutTitle}}{{copy.aboutTitle}}{{else}}First, your story.<br><em>Then, the details.</em>{{/if}}</h2><p>{{about}}</p><a class="text-link" href="#contact">Tell us what you have in mind <img src="./assets/arrow-up-right.svg" alt="" width="19" height="19"></a></div></section>{{/if}}

    {{#if liveGoogle}}<section class="google-gallery gallery-section section" id="gallery" hidden aria-labelledby="gallery-title"><div class="container"><div class="section-top"><div><p class="eyebrow" data-gallery-eyebrow>A CLOSER LOOK</p><h2 id="gallery-title" data-gallery-title>A little <em>closer.</em></h2></div><span class="google-mark" translate="no">Google Maps</span></div><div class="portfolio-grid" data-gallery></div><a data-maps-link class="text-link" href="{{mapsHref}}" target="_blank" rel="noopener noreferrer">View on Google Maps <img src="./assets/arrow-up-right.svg" alt="" width="18" height="18"></a></div></section>{{/if}}
    {{#if reference}}{{#unless about}}<section class="section about container text-only" id="about" data-profile-about hidden aria-labelledby="about-title"><figure class="about-photo" data-about-photo hidden><img alt="" width="1100" height="733" loading="lazy"><figcaption data-about-credit></figcaption></figure><div class="about-copy"><p class="eyebrow">A LITTLE ABOUT US</p><h2 id="about-title" data-profile-about-title></h2><p data-profile-about-copy></p><p data-profile-about-invitation></p><span class="google-mark" translate="no">Google Maps</span><a class="text-link" href="#contact"><span data-contact-label>Get in touch</span><img src="./assets/arrow-up-right.svg" alt="" width="19" height="19"></a></div></section>{{/unless}}{{/if}}
    {{#if liveGoogle}}
    <section class="reviews section" id="reviews" hidden><div class="container"><div class="section-top"><div><p class="eyebrow">REVIEWS</p><h2>In their <em>words.</em></h2></div><div class="review-summary"><strong><span data-live="rating"></span> / 5</strong><span data-live="reviewCount"></span><span class="google-mark" translate="no">Google Maps</span></div></div><p class="review-disclosure">Reviews returned by Google, ordered by relevance. Google checks for fake content but does not verify every review.</p><div class="review-grid" data-reviews></div></div></section>{{/if}}

    {{#if copy.faqs}}<section class="section faq container" id="questions" aria-labelledby="faq-title"><div><p class="eyebrow">BEFORE WE BEGIN</p><h2 id="faq-title">A few things<br><em>you might ask.</em></h2></div><div class="faq-list">{{#each copy.faqs}}<details><summary>{{question}}<img src="./assets/plus.svg" alt="" width="20" height="20"></summary><p>{{answer}}</p></details>{{/each}}</div></section>{{/if}}
    {{#if reference}}{{#unless copy.faqs}}<section class="section faq container" id="questions" data-profile-faq hidden aria-labelledby="faq-title"><div><p class="eyebrow">GOOD TO KNOW</p><h2 id="faq-title">Before you<br><em>stop by.</em></h2><span class="google-mark" translate="no">Google Maps</span></div><div class="faq-list" data-profile-faq-list></div></section>{{/unless}}{{/if}}

    <section class="contact-section section" id="contact" aria-labelledby="contact-title"><div class="container contact-grid {{#unless hasEnquiry}}without-form{{/unless}}"><div class="contact-copy"><p class="eyebrow">LET'S MAKE A CONNECTION</p><h2 id="contact-title" {{#if reference}}data-profile-contact-title{{/if}}>Something<br>lovely <em>starts here.</em></h2><p {{#if reference}}data-profile-contact-intro{{/if}}>Talk to <span {{#if liveBrand}}data-profile-brand{{/if}}>{{#unless liveBrand}}{{displayName}}{{/unless}}</span>.</p>
      <div class="contact-actions"><a class="button" {{#unless phone}}data-live-phone hidden{{/unless}} href="{{phoneHref}}"><span data-call-label>Call the business</span> <img src="./assets/arrow-up-right.svg" alt="" width="18" height="18"></a>{{#if whatsappHref}}<a class="button" href="{{whatsappHref}}" target="_blank" rel="noopener noreferrer">WhatsApp <img src="./assets/arrow-up-right.svg" alt="" width="18" height="18"></a>{{/if}}{{#if email}}<a class="text-link" href="mailto:{{email}}">{{email}}</a>{{/if}}</div>
      <div class="contact-location"><img src="./assets/pin.svg" alt="" width="20" height="20"><span {{#if reference}}data-live="city"{{/if}}>{{city}}</span></div>
      <div class="contact-details"><p {{#if liveGoogle}}{{#unless address}}data-live="address"{{/unless}}{{/if}}>{{address}}</p><a data-maps-link class="text-link" href="{{mapsHref}}" {{#unless mapsHref}}hidden{{/unless}} target="_blank" rel="noopener noreferrer">Get directions <img src="./assets/arrow-up-right.svg" alt="" width="18" height="18"></a><div class="hours" data-hours-block {{#unless hours}}hidden{{/unless}}><h3>Opening hours</h3><div data-hours>{{hours}}</div></div>{{#if liveGoogle}}<div class="provider-note" data-provider-note><span class="google-mark" translate="no">Google Maps</span></div>{{/if}}</div>
    </div>
    {{#if hasEnquiry}}<form class="enquiry-form" id="enquiry-form" data-preview-only="{{demo}}"><div class="form-heading"><h3>Your event, at a glance.</h3><span>{{#if demo}}ENQUIRY PREVIEW{{else}}LET'S TALK{{/if}}</span></div><fieldset><legend>What are you celebrating?</legend><div class="occasion-options"><label><input type="radio" name="occasion" value="Wedding" checked><span>Wedding</span></label><label><input type="radio" name="occasion" value="Birthday"><span>Birthday</span></label><label><input type="radio" name="occasion" value="Corporate gathering"><span>Corporate</span></label><label><input type="radio" name="occasion" value="Other"><span>Other</span></label></div></fieldset><div class="form-grid"><label>Your name<input name="name" autocomplete="name" required maxlength="100" placeholder="Name"></label><label>Email address<input name="email" type="email" autocomplete="email" required maxlength="200" placeholder="you@example.com"></label><label>Event date <span class="optional">(optional)</span><input name="date" type="date"></label><label>Guest count <span class="optional">(optional)</span><select name="guests"><option value="">Not sure yet</option><option>Up to 50</option><option>51-100</option><option>101-200</option><option>More than 200</option></select></label></div><label>What do you have in mind?<textarea name="message" rows="3" maxlength="1200" placeholder="The venue, an idea, a feeling..."></textarea></label><button class="button submit-button" type="submit" disabled>{{#if demo}}Preview enquiry{{else}}Review enquiry{{/if}}<img src="./assets/arrow-up-right.svg" alt="" width="19" height="19"></button><p class="form-disclosure">{{#if demo}}Design sample only. Nothing is sent or stored.{{else}}Review before opening your email or WhatsApp. Nothing is sent automatically.{{/if}}</p></form>{{/if}}</div></section>
  </main>
  <footer class="footer container"><a class="wordmark" href="#home"><span class="wordmark-name"><span {{#if liveBrand}}data-profile-brand{{/if}}>{{#if liveBrand}}Welcome{{else}}{{displayName}}{{/if}}</span><span class="wordmark-dot">.</span></span></a><span class="footer-byline">WEBSITE BY BUZL</span>{{#if illustrativeHero}}<a class="footer-link" href="https://unsplash.com/license" target="_blank" rel="noopener noreferrer">Illustrative photography / Unsplash</a>{{/if}}</footer>
  <div class="mobile-enquire" inert><a href="#contact"><span {{#if reference}}data-contact-label{{/if}}>Get in touch</span> <img src="./assets/arrow-up-right.svg" alt="" width="19" height="19"></a></div>
  <dialog class="photo-dialog" data-photo-dialog aria-label="Photograph"><header><span data-photo-count></span><button class="icon-button close-photo" data-close-photo type="button" title="Close photograph" aria-label="Close photograph"></button></header><div class="photo-viewer"><button class="icon-button photo-prev" type="button" title="Previous photograph" aria-label="Previous photograph" hidden></button><img class="large-photo" alt=""><button class="icon-button photo-next" type="button" title="Next photograph" aria-label="Next photograph" hidden></button></div><div class="photo-caption"><h2 data-photo-caption></h2><div data-photo-credit></div></div></dialog>
  {{#if hasEnquiry}}<dialog class="enquiry-dialog" id="enquiry-dialog" aria-labelledby="enquiry-title"><header><span class="eyebrow">YOUR EVENT</span><button class="icon-button" type="button" data-close-enquiry title="Close enquiry" aria-label="Close enquiry"><img src="./assets/close.svg" alt="" width="21" height="21"></button></header><h2 id="enquiry-title">A lovely place<br>to <em>start.</em></h2><p class="preview-notice">{{#if demo}}This is an enquiry preview. Nothing has been sent or stored.{{else}}Nothing has been sent. Choose where to open your message, then send it yourself.{{/if}}</p><dl data-enquiry-summary></dl>{{#unless demo}}{{#if whatsappHref}}<a class="button" data-enquiry-whatsapp href="{{whatsappHref}}" target="_blank" rel="noopener noreferrer">Open WhatsApp <img src="./assets/arrow-up-right.svg" alt="" width="18" height="18"></a>{{/if}}{{#if email}}<a class="button" data-enquiry-email href="mailto:{{email}}">Open email <img src="./assets/arrow-up-right.svg" alt="" width="18" height="18"></a>{{/if}}{{/unless}}<button class="text-link" type="button" data-close-enquiry>Continue editing</button></dialog>{{/if}}
</body>
</html>
