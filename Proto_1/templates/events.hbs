<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="{{robots}}"><meta name="proto-site-id" content="{{siteId}}">
  <title>{{title}}</title><meta name="description" content="{{metaDescription}}">
  <meta property="og:title" content="{{title}}"><meta property="og:description" content="{{metaDescription}}"><meta property="og:type" content="website">
  <link rel="stylesheet" href="./style.css"><script src="./site.js" defer></script>
</head>
<body class="palette-{{palette}} layout-{{layout}}" data-google-enabled="{{liveGoogle}}" data-reference="{{reference}}" data-hero-index="{{googleHeroIndex}}">
  {{#if demo}}<div class="sample-banner">Fictional business demonstration. Sample content, not a real business.</div>{{/if}}
  <header class="site-header">
    <a href="#home" class="brand"><span class="brand-mark" aria-hidden="true">&amp;</span><span><strong {{#if reference}}data-live="name"{{/if}}>{{displayName}}</strong><small {{#if reference}}data-live="category"{{/if}}>{{#unless reference}}{{category}}{{/unless}}</small></span></a>
    <nav aria-label="Main navigation"><a href="#about">The business</a><a href="#services" {{#unless services}}hidden{{/unless}}>Services</a><a href="#gallery" data-gallery-nav hidden>Gallery</a><a href="#reviews" data-review-nav hidden>Reviews</a></nav>
    <a href="#contact" class="header-cta">Get in touch <span aria-hidden="true">&#8599;</span></a>
  </header>
  <main>
    <section class="hero {{#if hasLocalImage}}has-image{{/if}}" id="home">
      {{#if hasLocalImage}}<img class="hero-photo" src="./hero.webp" alt="{{#if imageLabel}}Illustrative template image{{else}}{{displayName}} photograph{{/if}}" fetchpriority="high">{{else}}<img class="hero-photo" data-hero-photo alt="" hidden fetchpriority="high">{{/if}}
      <div class="hero-inner wrap"><div class="hero-copy"><p class="eyebrow"><span {{#if reference}}data-live="category"{{/if}}>{{#unless reference}}{{category}}{{/unless}}</span><span class="hero-city" {{#if reference}}data-live="city"{{/if}}>{{city}}</span></p><h1 {{#if reference}}data-live="name"{{/if}}>{{displayName}}</h1>{{#if copy.headline}}<p class="hero-headline">{{copy.headline}}</p>{{/if}}{{#if intro}}<p class="hero-intro">{{intro}}</p>{{/if}}<div class="hero-actions"><a href="#contact" class="button">Let's connect <span aria-hidden="true">&#8599;</span></a><a href="#gallery" class="text-link" data-gallery-nav hidden>Explore the gallery</a></div>{{#if reference}}<span class="google-mark" translate="no">Google Maps</span>{{/if}}</div></div>
      <div class="hero-credit" data-hero-credit>{{imageLabel}}</div><span class="hero-scroll" aria-hidden="true">Discover below &#8595;</span>
    </section>
    <div class="profile-strip" data-profile-strip hidden><div class="wrap"><div><span class="rating-star" aria-hidden="true">&#9733;</span><strong data-live="rating"></strong><span data-live="reviewCount"></span></div><span data-live="category"></span><a data-maps-link href="{{mapsHref}}" target="_blank" rel="noopener noreferrer">View Google profile &#8599;</a><span class="google-mark" translate="no">Google Maps</span></div></div>
    <div class="google-status wrap" data-google-status role="status" {{#unless liveGoogle}}hidden{{/unless}}>Loading Google business details...</div>
    <section class="about wrap section" id="about"><div class="section-label"><span>01 / INTRODUCTION</span><p>Meet the business.</p></div><div><h2>{{#if copy.aboutTitle}}{{copy.aboutTitle}}{{else}}A closer look.{{/if}}</h2>{{#if about}}<p class="body-copy">{{about}}</p>{{/if}}<div class="business-facts"><div><span>Business</span><strong {{#if reference}}data-live="name"{{/if}}>{{displayName}}</strong></div><div><span>Based in</span><strong {{#if reference}}data-live="city"{{/if}}>{{city}}</strong></div><div data-contact-phone {{#unless phone}}hidden{{/unless}}><span>Contact</span><a {{#unless phone}}data-live-phone{{/unless}} href="{{phoneHref}}">{{phone}}</a></div></div>{{#if reference}}<span class="google-mark" translate="no">Google Maps</span>{{/if}}<a href="#contact" class="arrow-link">Start a conversation <span aria-hidden="true">&#8594;</span></a></div></section>
    {{#if services}}<section class="services section" id="services"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">02 / SERVICES</p><h2>Thoughtfully put together.</h2></div><a href="#contact" class="arrow-link">Discuss your plans &#8599;</a></div><div class="services-grid">{{#each services}}<article class="service"><span class="service-number">{{number}}</span><h3>{{title}}</h3>{{#if description}}<p>{{description}}</p>{{/if}}<a href="#contact" aria-label="Enquire about {{title}}">Let's talk <span aria-hidden="true">&#8599;</span></a></article>{{/each}}</div></div></section>{{/if}}
    <section class="gallery section wrap" id="gallery" hidden><div class="section-heading"><div><p class="eyebrow">THE GALLERY</p><h2>A little closer.</h2></div><div><p class="gallery-note">Photos from the Google business profile</p><span class="google-mark" translate="no">Google Maps</span></div></div><div class="gallery-grid" data-gallery></div><a data-maps-link class="arrow-link gallery-more" href="{{mapsHref}}" target="_blank" rel="noopener noreferrer">More on Google Maps &#8599;</a></section>
    <section class="reviews section" id="reviews" hidden><div class="wrap"><div class="section-heading"><div><p class="eyebrow">GOOGLE REVIEWS</p><h2>In their words.</h2></div><div class="review-summary"><strong><span data-live="rating"></span> <span aria-hidden="true">&#9733;</span></strong><span data-live="reviewCount"></span><span class="google-mark" translate="no">Google Maps</span></div></div><p class="review-disclosure">Reviews returned by Google, ordered by relevance. Google checks for fake content but does not verify every review.</p><div class="review-grid" data-reviews></div></div></section>
    {{#if copy.faqs}}<section class="faq section wrap"><div><p class="eyebrow">BEFORE WE TALK</p><h2>A few helpful answers.</h2></div><div>{{#each copy.faqs}}<details><summary>{{question}}<span aria-hidden="true">+</span></summary><p>{{answer}}</p></details>{{/each}}</div></section>{{/if}}
    <section class="contact section" id="contact"><div class="wrap contact-grid"><div><p class="eyebrow">YOUR NEXT STEP</p><h2>Let's make<br>the connection.</h2><p>Talk to <span {{#if reference}}data-live="name"{{/if}}>{{displayName}}</span>.</p><div class="contact-actions"><a class="button" {{#unless phone}}data-live-phone hidden{{/unless}} href="{{phoneHref}}">Call the business &#8599;</a>{{#if whatsappHref}}<a class="button button-outline" href="{{whatsappHref}}" target="_blank" rel="noopener noreferrer">WhatsApp</a>{{/if}}{{#if email}}<a class="button button-outline" href="mailto:{{email}}">Email</a>{{/if}}</div></div><div class="contact-details"><h3>Find us</h3><p {{#unless address}}data-live="address"{{/unless}}>{{address}}</p><a href="{{mapsHref}}" class="arrow-link" data-maps-link target="_blank" rel="noopener noreferrer" {{#unless mapsHref}}hidden{{/unless}}>Get directions &#8599;</a><div class="hours" data-hours-block {{#unless hours}}hidden{{/unless}}><h3>Opening hours</h3><div data-hours>{{hours}}</div></div><div class="provider-note" data-provider-note><span class="google-mark" translate="no" {{#unless liveGoogle}}hidden{{/unless}}>Google Maps</span></div></div></div></section>
  </main>
  <footer class="footer wrap"><a href="#home" class="footer-name" {{#if reference}}data-live="name"{{/if}}>{{displayName}}</a><span>&copy; {{year}}. All rights reserved.</span><span>Website by Buzl x Grexa</span></footer>
  <div class="mobile-contact"><a href="#contact">Get in touch &#8599;</a><a data-maps-link href="{{mapsHref}}" target="_blank" rel="noopener noreferrer" {{#unless mapsHref}}hidden{{/unless}}>Directions</a></div>
  <dialog class="photo-dialog" data-photo-dialog><button type="button" data-close-photo>Close</button><img alt=""><div data-photo-credit></div></dialog>
</body>
</html>
