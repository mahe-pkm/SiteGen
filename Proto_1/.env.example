# Keep credentials in this local file or the VPS secret settings, never in Git.
GOOGLE_MAPS_API_KEY=
PORT=3100
HOST=127.0.0.1
DATA_DIR=.data
# Local dev can read ONLY GOOGLE_MAPS_API_KEY from ../app/.env.local when absent.
# Production never reads that fallback file.

# Required before running npm start or exposing the admin application.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_ORIGIN=

# Leave empty until DNS, wildcard TLS, and the dedicated Traefik router exist.
SITE_BASE_DOMAIN=
PUBLIC_DEPLOY_ENABLED=false

# Protected pilot only. The builder sends reviewed releases to this HTTPS gateway.
STAGING_ORIGIN=
STAGING_DEPLOY_TOKEN=
STAGING_REVIEW_USERNAME=review
STAGING_REVIEW_PASSWORD=

# Prevent runaway lookup costs in this single-process prototype.
LOOKUP_DAILY_LIMIT=100
PHOTO_DAILY_LIMIT=300
OPENROUTER_API_KEY=
AI_WRITER_MODEL=google/gemini-3.8-flash
AI_REPAIR_MODEL=anthropic/claude-sonnet-5
AI_DAILY_BUDGET_USD=5
AI_JOB_BUDGET_USD=0.50
